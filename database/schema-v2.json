{
  "version": 2,
  "database": "FlywookiStudio",
  "stores": {
    "inventory": {
      "keyPath": "id",
      "autoIncrement": true,
      "indexes": {
        "cnId": {
          "unique": true
        },
        "categoryId": {
          "unique": false
        },
        "name": {
          "unique": false
        }
      }
    },
    "categories": {
      "keyPath": "id",
      "autoIncrement": true,
      "indexes": {
        "name": {
          "unique": true
        }
      }
    },
    "stock_movements": {
      "keyPath": "id",
      "autoIncrement": true,
      "indexes": {
        "cnId": {
          "unique": false
        },
        "date": {
          "unique": false
        },
        "type": {
          "unique": false
        }
      }
    },
    "settings": {
      "keyPath": "key",
      "autoIncrement": false
    }
  }
}
